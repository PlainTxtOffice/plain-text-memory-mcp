{
  "taxonomy_version": "7.0.0",
  "package": {
    "name": "plain-text-memory-mcp",
    "version": "0.4.0"
  },
  "record_types": {
    "entity": {
      "purpose": "A named thing the agents remember, such as a folder, module, library, or decision, with its notes. A heading in a MEMORY.ptm.md or AGENTS.md file starts one; a name used in several files is one entity.",
      "fields": {
        "type": "\"entity\"",
        "name": "string",
        "entityType": "string",
        "added_at": "string|null",
        "agent": "string|null",
        "notes": {
          "type": "note[]",
          "purpose": "One fact about an entity, inside its notes list: a bullet of a MEMORY.ptm.md file, or a bullet or paragraph of an AGENTS.md file. path is the file it came from. superseded_at and replaced_by appear once the bullet is struck through: superseded_at is its retirement stamp and replaced_by the live bullet it is nested under.",
          "fields": {
            "text": "string",
            "added_at": "string|null",
            "agent": "string|null",
            "path": "string (optional)",
            "superseded_at": "string|null (optional)",
            "replaced_by": "string (optional)"
          }
        }
      }
    },
    "relation": {
      "purpose": "A directed link between two entities, read from a bullet that is one verb and one [[link]], in active voice: reading_list uses sqlite.",
      "fields": {
        "type": "\"relation\"",
        "from": "string",
        "to": "string",
        "relationType": "string",
        "added_at": "string|null",
        "agent": "string|null"
      }
    },
    "access": {
      "purpose": "One line of .agents/ptm/access.jsonl, appended when an agent opens an entity; search ranks often-opened entities higher.",
      "fields": {
        "type": "\"access\"",
        "at": "string",
        "entity": "string"
      }
    },
    "recall": {
      "purpose": "One line of .agents/ptm/recall.jsonl, a development log written only when MEMORY_RECALL_LOG=1: a recall step with its thought, queries, hits, and conclusion, or a search_nodes or open_nodes call.",
      "fields": {
        "type": "\"recall\"",
        "kind": "string",
        "at": "string",
        "agent": "string",
        "queries": "query[] (optional)",
        "hits": "hit[] (optional)",
        "session": "string (optional)",
        "step": "integer (optional)",
        "total_steps": "integer (optional)",
        "revises_step": "null|integer (optional)",
        "thought": "string (optional)",
        "names": "name[] (optional)",
        "seen": "integer (optional)",
        "conclusion": "null|string (optional)",
        "sources": "source[] (optional)"
      }
    }
  },
  "enums": {
    "agent": [
      "claude-code",
      "codex",
      "unknown"
    ]
  },
  "tools": {
    "open_nodes": {
      "description": "Open entities by exact name.",
      "params": {
        "names": [
          "string"
        ],
        "include_superseded": "boolean"
      },
      "returns": {
        "entities": [
          {
            "type": "\"entity\"",
            "name": "string",
            "entityType": "string",
            "added_at": "string|null",
            "agent": "string|null",
            "notes": [
              {
                "text": "string",
                "added_at": "string|null",
                "agent": "string|null",
                "superseded_at": "string|null",
                "replaced_by": "string|null",
                "path": "string"
              }
            ]
          }
        ],
        "relations": [
          {
            "type": "\"relation\"",
            "from": "string",
            "to": "string",
            "relationType": "string",
            "added_at": "string|null",
            "agent": "string|null"
          }
        ]
      }
    },
    "recall": {
      "description": "Search memory in steps, recording why each search was made.",
      "params": {
        "thought": "string",
        "step": "integer",
        "total_steps": "integer",
        "next_step_needed": "boolean",
        "queries": [
          "string"
        ],
        "open": [
          "string"
        ],
        "revises_step": "integer|null",
        "conclusion": "string|null",
        "sources": [
          {
            "entityName": "string",
            "text": "string"
          }
        ],
        "session": "string|null",
        "path": "string|null"
      },
      "returns": {
        "session": "string",
        "step": "integer",
        "total_steps": "integer",
        "next_step_needed": "boolean",
        "hits": [
          {
            "rank": "integer",
            "score": "number",
            "entityName": "string",
            "note": {
              "text": "string",
              "added_at": "string|null",
              "agent": "string|null",
              "superseded_at": "string|null",
              "replaced_by": "string|null",
              "path": "string"
            }
          }
        ],
        "entities": [
          {
            "type": "\"entity\"",
            "name": "string",
            "entityType": "string",
            "added_at": "string|null",
            "agent": "string|null",
            "notes": [
              {
                "text": "string",
                "added_at": "string|null",
                "agent": "string|null",
                "superseded_at": "string|null",
                "replaced_by": "string|null",
                "path": "string"
              }
            ]
          }
        ],
        "relations": [
          {
            "type": "\"relation\"",
            "from": "string",
            "to": "string",
            "relationType": "string",
            "added_at": "string|null",
            "agent": "string|null"
          }
        ],
        "unopened": [
          "string"
        ],
        "seen": "integer",
        "warnings": [
          "string"
        ]
      }
    },
    "search_nodes": {
      "description": "Search entities and notes, ranked by BM25 relevance.",
      "params": {
        "query": "string",
        "since": "string|null",
        "before": "string|null",
        "agent": "string|null",
        "limit": "integer|null",
        "expand": "boolean",
        "include_superseded": "boolean"
      },
      "returns": {
        "entities": [
          {
            "type": "\"entity\"",
            "name": "string",
            "entityType": "string",
            "added_at": "string|null",
            "agent": "string|null",
            "notes": [
              {
                "text": "string",
                "added_at": "string|null",
                "agent": "string|null",
                "superseded_at": "string|null",
                "replaced_by": "string|null",
                "path": "string"
              }
            ]
          }
        ],
        "relations": [
          {
            "type": "\"relation\"",
            "from": "string",
            "to": "string",
            "relationType": "string",
            "added_at": "string|null",
            "agent": "string|null"
          }
        ],
        "hits": [
          {
            "rank": "integer",
            "score": "number",
            "entityName": "string",
            "note": {
              "text": "string",
              "added_at": "string|null",
              "agent": "string|null",
              "superseded_at": "string|null",
              "replaced_by": "string|null",
              "path": "string"
            }
          }
        ]
      }
    },
    "stamp_notes": {
      "description": "Stamp new and changed notes in memory files, then screen them.",
      "params": {
        "paths": [
          "string"
        ]
      },
      "returns": {
        "files": [
          {
            "path": "string",
            "stamped": "integer",
            "retired": "integer",
            "archived": "integer"
          }
        ],
        "warnings": [
          {
            "kind": "near_duplicate|instruction_like|secret|broken_link|long_file|no_reason",
            "entityName": "string",
            "text": "string",
            "path": "string",
            "message": "string"
          }
        ]
      }
    }
  },
  "resources": {
    "memory://taxonomy": {
      "name": "taxonomy",
      "title": "Memory taxonomy",
      "description": "The server's versioned schema: record types and their fields, tools with their parameters and results, allowed enum values, resources, prompts, and the changelog.",
      "mime_type": "application/json"
    }
  },
  "prompts": {},
