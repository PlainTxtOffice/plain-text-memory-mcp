{
  "taxonomy_version": "2.8.1",
  "package": {
    "name": "plain-text-memory-mcp",
    "version": "0.3.0"
  },
  "record_types": {
    "header": {
      "purpose": "First line of the memory file. Names the repo that owns it, so a copy in another repo is detected.",
      "fields": {
        "type": "\"header\"",
        "repo_name": "string",
        "repo_root": "string",
        "added_at": "string|null",
        "agent": "string|null"
      }
    },
    "entity": {
      "purpose": "A named thing the agents remember, such as a repo, module, library, person, or decision, with its observations.",
      "fields": {
        "type": "\"entity\"",
        "name": "string",
        "entityType": "string",
        "added_at": "string|null",
        "agent": "string|null",
        "observations": "observation[]"
      }
    },
    "relation": {
      "purpose": "A directed link between two entities, in active voice: reading_list uses sqlite.",
      "fields": {
        "type": "\"relation\"",
        "from": "string",
        "to": "string",
        "relationType": "string",
        "added_at": "string|null",
        "agent": "string|null"
      }
    },
    "observation": {
      "purpose": "One fact about an entity, stored inside the entity's observations list. edited_at and edited_by appear once its text is edited; superseded_at, superseded_by, and replaced_by once it is retired; sources when it was derived from other observations.",
      "fields": {
        "text": "string",
        "added_at": "string|null",
        "agent": "string|null",
        "sources": "source[] (optional)",
        "superseded_at": "string|null (optional)",
        "superseded_by": "string|null (optional)",
        "replaced_by": "string (optional)",
        "edited_at": "string|null (optional)",
        "edited_by": "string|null (optional)"
      }
    },
    "tombstone": {
      "purpose": "Removes the entity or relation it names. Writes append changed records and tombstones; a later line for the same entity or relation replaces an earlier one, until compaction rewrites the file with one line per record.",
      "fields": {
        "type": "\"tombstone\"",
        "entity": "string (optional)",
        "from": "string (optional)",
        "to": "string (optional)",
        "relationType": "string (optional)"
      }
    },
    "access": {
      "purpose": "One line of memory.local.access.jsonl, appended when an agent opens an entity; search ranks often-opened entities higher.",
      "fields": {
        "type": "\"access\"",
        "at": "string",
        "entity": "string"
      }
    }
  },
  "enums": {
    "agent": [
      "claude-code",
      "codex",
      "unknown"
    ],
    "initialize_memory.mode": [
      "fresh",
      "adopt"
    ],
    "initialize_memory.status": [
      "unchanged",
      "fresh",
      "initialized",
      "adopted"
    ]
  },
